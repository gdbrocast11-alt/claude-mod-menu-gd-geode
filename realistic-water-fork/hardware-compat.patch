+		} catch (NoSuchAlgorithmException e) {
+			return null;
+		}
+	}
+
+	private static @Nullable ByteBuffer readCache(String key) {
+		Path dir = cacheDir();
+		if (dir == null) {
+			return null;
+		}
+		Path file = dir.resolve(key + ".spv");
+		try {
+			if (!Files.isRegularFile(file)) {
+				return null;
+			}
+			byte[] data = Files.readAllBytes(file);
+			// SPIR-V is a stream of 32-bit words starting with the magic number 0x07230203.
+			if (data.length < 20 || data.length % 4 != 0 || data[0] != 0x03 || data[1] != 0x02 || data[2] != 0x23 || data[3] != 0x07) {
+				Files.deleteIfExists(file);
+				return null;
+			}
+			ByteBuffer buf = MemoryUtil.memAlloc(data.length);
+			buf.put(data).flip();
+			return buf;
+		} catch (IOException e) {
+			return null;
+		}
+	}
