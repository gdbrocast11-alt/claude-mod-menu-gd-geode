new file mode 100644
index 0000000..a5e0176
--- /dev/null
+++ b/src/client/java/me/skaffy/client/vk/GpuCaps.java
@@ -0,0 +1,119 @@
+package me.skaffy.client.vk;
+
+import me.skaffy.RealisticWater;
+import org.lwjgl.system.MemoryStack;
+import org.lwjgl.vulkan.VK10;
+import org.lwjgl.vulkan.VK11;
+import org.lwjgl.vulkan.VkPhysicalDevice;
+import org.lwjgl.vulkan.VkPhysicalDeviceLimits;
+import org.lwjgl.vulkan.VkPhysicalDeviceMemoryProperties;
+import org.lwjgl.vulkan.VkPhysicalDeviceProperties;
+import org.lwjgl.vulkan.VkPhysicalDeviceProperties2;
+import org.lwjgl.vulkan.VkPhysicalDeviceSubgroupProperties;
+
+/**
+ * What the GPU can actually do, read once from Vulkan.
+ *
+ * Fork addition: the original shaders assumed 1024-thread workgroups and full subgroup
+ * arithmetic support. Both are optional in Vulkan, so this probe lets shaders adapt.
+ */
+public final class GpuCaps {
+	private static final int NEEDED_SUBGROUP_OPS = VK11.VK_SUBGROUP_FEATURE_BASIC_BIT
+		| VK11.VK_SUBGROUP_FEATURE_ARITHMETIC_BIT
+		| VK11.VK_SUBGROUP_FEATURE_BALLOT_BIT;
+
+	private static boolean probed;
+	private static String name = "unknown";
+	private static int deviceType = VK10.VK_PHYSICAL_DEVICE_TYPE_OTHER;
+	private static int maxInvocations = 128;
+	private static int maxGroupSizeX = 128;
+	private static int maxSharedBytes = 16384;
+	private static boolean subgroups;
+	private static long deviceLocalBytes;
+
+	private GpuCaps() {
+	}
+
+	private static synchronized void probe() {
+		if (probed) {
+			return;
+		}
+		probed = true;
+		try (MemoryStack stack = MemoryStack.stackPush()) {
+			VkPhysicalDevice phys = Vk.vk().getPhysicalDevice();
+
+			VkPhysicalDeviceSubgroupProperties sub = VkPhysicalDeviceSubgroupProperties.calloc(stack).sType$Default();
+			VkPhysicalDeviceProperties2 props2 = VkPhysicalDeviceProperties2.calloc(stack).sType$Default().pNext(sub);
+			VK11.vkGetPhysicalDeviceProperties2(phys, props2);
+			VkPhysicalDeviceProperties props = props2.properties();
+			VkPhysicalDeviceLimits limits = props.limits();
+
+			name = props.deviceNameString();
+			deviceType = props.deviceType();
+			maxInvocations = limits.maxComputeWorkGroupInvocations();
+			maxGroupSizeX = limits.maxComputeWorkGroupSize(0);
+			maxSharedBytes = limits.maxComputeSharedMemorySize();
+			subgroups = (sub.supportedStages() & VK10.VK_SHADER_STAGE_COMPUTE_BIT) != 0
+				&& (sub.supportedOperations() & NEEDED_SUBGROUP_OPS) == NEEDED_SUBGROUP_OPS;
+
+			VkPhysicalDeviceMemoryProperties mem = VkPhysicalDeviceMemoryProperties.calloc(stack);
+			VK10.vkGetPhysicalDeviceMemoryProperties(phys, mem);
+			long best = 0L;
+			for (int i = 0; i < mem.memoryHeapCount(); i++) {
+				if ((mem.memoryHeaps(i).flags() & VK10.VK_MEMORY_HEAP_DEVICE_LOCAL_BIT) != 0) {
+					best = Math.max(best, mem.memoryHeaps(i).size());
+				}
+			}
+			deviceLocalBytes = best;
+		} catch (Throwable t) {
+			RealisticWater.LOGGER.warn("Realistic Water couldn't read GPU limits, using the safest settings", t);
+		}
+		RealisticWater.LOGGER.info("Realistic Water GPU: {} ({}), {} MiB VRAM, max workgroup {} (x {}), shared {} KiB, subgroup ops: {} -> large group {}",
+			name, typeName(), deviceLocalBytes >> 20, maxInvocations, maxGroupSizeX, maxSharedBytes >> 10, subgroups, largeGroup());
+	}
+
+	/** Largest power-of-two workgroup up to 1024 the device runs, never below the Vulkan minimum of 128. */
+	public static int largeGroup() {
+		probe();
+		int limit = Math.min(1024, Math.min(maxInvocations, maxGroupSizeX));
+		// The single-group solver keeps 3 arrays of this many 4-byte values in shared memory.
+		limit = Math.min(limit, Math.max(128, maxSharedBytes / 12));
+		int g = 128;
+		while (g * 2 <= limit) {
+			g *= 2;
+		}
+		return g;
+	}
+
+	/** True when compute shaders can use subgroup basic, arithmetic and ballot operations. */
+	public static boolean subgroups() {
+		probe();
+		return subgroups;
+	}
+
+	/** Integrated GPUs share system RAM and are usually much slower: used to pick lighter first-run defaults. */
+	public static boolean integrated() {
+		probe();
+		return deviceType == VK10.VK_PHYSICAL_DEVICE_TYPE_INTEGRATED_GPU || deviceType == VK10.VK_PHYSICAL_DEVICE_TYPE_CPU;
+	}
+
+	public static long deviceLocalBytes() {
+		probe();
+		return deviceLocalBytes;
+	}
+
+	public static String name() {
+		probe();
+		return name;
+	}
+
+	private static String typeName() {
+		return switch (deviceType) {
+			case VK10.VK_PHYSICAL_DEVICE_TYPE_DISCRETE_GPU -> "discrete";
+			case VK10.VK_PHYSICAL_DEVICE_TYPE_INTEGRATED_GPU -> "integrated";
+			case VK10.VK_PHYSICAL_DEVICE_TYPE_VIRTUAL_GPU -> "virtual";
+			case VK10.VK_PHYSICAL_DEVICE_TYPE_CPU -> "software";
+			default -> "other";
+		};
+	}
+}
