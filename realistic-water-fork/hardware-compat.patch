+		}
+		try {
+			Files.createDirectories(dir);
+			byte[] data = new byte[spv.remaining()];
+			spv.duplicate().get(data);
+			Path tmp = Files.createTempFile(dir, key, ".tmp");
+			Files.write(tmp, data);
+			Files.move(tmp, dir.resolve(key + ".spv"), StandardCopyOption.REPLACE_EXISTING, StandardCopyOption.ATOMIC_MOVE);
+		} catch (IOException | UnsupportedOperationException e) {
+			RealisticWater.LOGGER.debug("Couldn't cache shader {}", key, e);
 		}
 	}
 }
